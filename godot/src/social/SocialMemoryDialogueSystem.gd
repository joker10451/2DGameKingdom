class_name SocialMemoryDialogueSystem
extends RefCounted

## ДИНАМИЧЕСКАЯ СОЦИАЛЬНАЯ ПАМЯТЬ И ВЕТВЯЩИЕСЯ ДИАЛОГИ
## Формирует реактивные реплики жителей с учетом недавних событий в мире

func get_contextual_greeting(npc: Dictionary, world_context: Dictionary) -> String:
	var name: String = npc.get("name", "Горожанин")
	var role: String = npc.get("role", "Житель")
	var rep: int = npc.get("reputation_to_player", 0)
	
	# 1. Реакция на недавний отраженный набег
	if world_context.get("recent_raid_repelled", false):
		return "«Хвала небесам и вашей доблести, милорд! Если бы не вы и городская стража, эти лесные головорезы сожгли бы наши дома дотла!»"
		
	# 2. Реакция на победу над Боссом Мальгримом
	if world_context.get("boss_malgrim_dead", false):
		return "«Вся Олдерия только и говорит о вашем подвиге в Склепе Забытых! Проклятый Рыцарь Мальгрим повержен, слава защитнику наших земель!»"
		
	# 3. Высокая репутация (Друг)
	if rep >= 40:
		return "«Всегда рад видеть доброго друга! Чем могу помочь тебе сегодня, благородный герой?»"
		
	# 4. Низкая репутация (Неприязнь)
	if rep <= -20:
		return "«Чего тебе нужно? Не загораживай дорогу, у меня и без тебя полно хлопот...»"
		
	# 5. Стандартное приветствие по ремеслу
	match role:
		"Кузнец":
			return "«Здравствуй! Горн гудит, сталь плавится. Ищешь добрый клинок или починить подковы?»"
		"Знахарка", "Травница":
			return "«Мир тебе, путник. Пахнет чабрецом и мятой. Нужны ли целебные настойки от хвори?»"
		"Трактирщица":
			return "«Добро пожаловать в таверну «Золотой Кабан»! У нас сегодня свежий ячменный эль и жареное мясо на вертеле!»"
		"Хлебопашец", "Крестьянин":
			return "«Доброго дня! Земля нынче щедрая, лишь бы дожди не подвели к жатве.»"
		_:
			return "«Приветствую тебя в Олдерии, путник!»"

func get_gossip_topic(npc: Dictionary, world_context: Dictionary) -> Dictionary:
	var gossips = [
		"«Говорят, в Чернолесье на северо-западе разбойники свили себе укрепленный лагерь. Их атаман Бран не знает пощады...»",
		"«Купцы на площади шепчутся, что на днях прибудет заморский купеческий караван с редкими шелками и рубинами!»",
		"«Старый рыбак клянется, что видел на речном перекате огромного Царского Осетра. Тот, кто поймает его, озолотится!»",
		"«По вечерам в таверне собирается вся деревня. Музыка, эль рекой... правда, иногда и до пьяных кулачных боев доходит!»"
	]
	var chosen = gossips[randi() % gossips.size()]
	return {
		"title": "🗣️ Слухи и Сплетни Олдерии",
		"text": chosen
	}

func get_village_opinion(npc: Dictionary, tax_rate: int = 10) -> Dictionary:
	var text = ""
	if tax_rate >= 20:
		text = "«Налоги, конечно, высоковаты... Казна богатеет, но крестьянам приходится затягивать пояса туже.»"
	elif tax_rate <= 5:
		text = "«Жизнь в Олдерии прекрасна! Подати почти не ощущаются, народ доволен и славит правителя!»"
	else:
		text = "«Жить можно! Подати умеренные, стража на улицах держит порядок, а в амбарах всегда есть зерно.»"
		
	return {
		"title": "🏰 Мнение о Жизни в Деревне",
		"text": text
	}

func get_character_backstory(npc: Dictionary) -> Dictionary:
	var role = npc.get("role", "Житель")
	var traits = ", ".join(npc.get("traits", ["Трудолюбивый"]))
	var goal = npc.get("goal", "Жить честным трудом")
	
	var bio = "Я родился и вырос в этих краях. Мой характер: %s. Моя главная мечта — %s." % [traits, goal]
	return {
		"title": "📜 Предыстория: %s" % npc.get("name", "Житель"),
		"text": bio
	}
