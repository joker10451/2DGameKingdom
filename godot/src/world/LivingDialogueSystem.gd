static func get_dialogue_content(npc: Dictionary, p: CharacterData, weather: String, hour: int) -> Dictionary:
	var role = npc.get("role_prof", npc.get("role", "farmer"))
	var name_str = npc.get("name", "Житель")
	var gift_item := ""
	var text_body := ""
	
	match role:
		"blacksmith":
			text_body = "Приветствую, лорд! Слышите, как наковальня поет? Сталь любит твердую руку и жаркий уголь. Заходите погреться к горну — в такую погоду лучше места нет!"
		"baker":
			text_body = "С пылу с жару, милсдарь! Держите горбушку свежего хлеба — пока тесто всходит, душа радуется! От доброго хлебного духа и в избе теплее."
			if randf() < 0.40 and p: gift_item = "bread"
		"farmer":
			text_body = "Землица наша щедрая, коли с поклоном к ней. Вон колоски как налились! Если дождик пройдет — к осени полные амбары зерна соберем."
			if randf() < 0.35 and p: gift_item = "wheat"
		"woodcutter":
			text_body = "Смола дубовая дух захватывает! Пока топор острый да руки целы — и стены поднимем, и частокол сладим. Лес уважать надо, он и укроет, и накормит."
		"guard":
			text_body = "На рубежах все спокойно, лорд. Дозоры расставлены, лучники на вышках. С такими стенами и спится слаще. Можете не сомневаться — город под надежной защитой!"
		_:
			text_body = "Добрый день, милсдарь! Спасибо вам за этот город. Раньше бродяжничали по трактам, а теперь здесь свой угол, теплый очаг и сытный хлеб на столе."
			
	if weather in ["rain", "storm"]:
		text_body += "\n\n[color=lightblue]🌧️ *поправляет плащ* «Эх, и припустил ливень! Хорошо, что в таверне камин жарко топится...»[/color]"
	elif hour >= 18:
		text_body += "\n\n[color=gold]🍺 *улыбается* «Рабочий день позади, самое время заглянуть в таверну на кружку доброго эля!»[/color]"
		
	if gift_item != "" and p:
		p.inventory[gift_item] = p.inventory.get(gift_item, 0) + 1
		var it_name = "Хлеб" if gift_item == "bread" else "Пшеница"
		text_body += "\n\n[color=green]🎁 %s с улыбкой протянул вам: [b]%s (+1)[/b]![/color]" % [name_str, it_name]
		
	return {
		"title": "%s (%s)" % [name_str, role.capitalize()],
		"text": text_body,
		"gift": gift_item
	}
