static func get_dialogue_content(npc: Dictionary, p: CharacterData, weather: String, hour: int, context: Dictionary = {}) -> Dictionary:
	var role = npc.get("role_prof", npc.get("role", "farmer"))
	var name_str = npc.get("name", "Житель")
	var gift_item := ""
	var text_body := ""
	var rep = npc.get("reputation_to_player", 0)
	
	# 1. Критические мировые ситуации (Голод / Бунт)
	if context.get("peasant_revolt", false):
		text_body = "🔥 [color=salmon]«Народ на взводе, милорд! Люди вышли на площадь с вилами и факелами! Снизьте подати или раздайте хлеб из амбаров, пока не запылали усадьбы!»[/color]"
	elif context.get("is_starving", false):
		text_body = "🥖 [color=salmon]«В амбарах гуляет ветер, милорд... На рынке не достать и корки хлеба. Если скоро не подвезут зерно — в городе начнется мор...»[/color]"
	elif rep <= -20:
		text_body = "😠 [color=salmon]«Чего тебе нужно? Держись от меня и моей лавки подальше, пока я не позвал городскую стражу!»[/color]"
	else:
		match role:
			"blacksmith":
				if rep >= 25:
					text_body = "⚒️ «Рад видеть истинного друга, милорд! Для вас у меня особая сталь и скидки на ковку. Слышите, как наковальня поет? Заходите погреться к горну!»"
				else:
					text_body = "Приветствую, путник! Слышите, как наковальня поет? Сталь любит твердую руку и жаркий уголь. Заходите погреться к горну — в такую погоду лучше места нет!"
			"baker":
				if rep >= 25:
					text_body = "🍞 «С пылу с жару для нашего благодетеля! Держите горячий каравай — от вашего доброго взгляда тесто подходит вдвое пышнее!»"
					if p: gift_item = "bread"
				else:
					text_body = "С пылу с жару, милсдарь! Держите горбушку свежего хлеба — пока тесто всходит, душа радуется! От доброго хлебного духа и в избе теплее."
					if randf() < 0.40 and p: gift_item = "bread"
			"farmer":
				text_body = "Землица наша щедрая, коли с поклоном к ней. Вон колоски как налились! Если дождик пройдет — к осени полные амбары зерна соберем."
				if randf() < 0.35 and p: gift_item = "wheat"
			"woodcutter":
				text_body = "Смола дубовая дух захватывает! Пока топор острый да руки целы — и стены поднимем, и частокол сладим. Лес уважать надо, он и укроет, и накормит."
			"guard":
				if context.get("recent_raid_won", false):
					text_body = "🛡️ «Слава Небесам и вашей отваге, командир! Налет разбойников отбит, ворота целы! Город знает своих защитников!»"
				else:
					text_body = "На рубежах все спокойно, лорд. Дозоры расставлены, лучники на вышках. С такими стенами и спится слаще. Можете не сомневаться — город под надежной защитой!"
			_:
				if context.get("boss_slain", false):
					text_body = "✨ «Весь город гудит: говорят, древнее чудище в склепе повержено вашим клинком! Да благословят вас боги!»"
				elif rep >= 30:
					text_body = "🌟 «Спасибо вам за этот город, благородный лорд! У нас теперь свой теплый очаг, сытный хлеб и надежное будущее.»"
				else:
					text_body = "Добрый день, милсдарь! Спасибо вам за этот город. Раньше бродяжничали по трактам, а теперь здесь свой угол, теплый очаг и сытный хлеб на столе."
			
	# Дополнительные атмосферные ремарки
	if weather in ["rain", "storm"]:
		text_body += "\n\n[color=lightblue]🌧️ *поправляет плащ* «Эх, и припустил ливень! Хорошо, что в таверне камин жарко топится...»[/color]"
	elif hour >= 18 and hour < 22:
		text_body += "\n\n[color=gold]🍺 *улыбается* «Рабочий день позади, самое время заглянуть в таверну на кружку доброго эля!»[/color]"
		
	if gift_item != "" and p:
		p.inventory[gift_item] = p.inventory.get(gift_item, 0) + 1
		var it_name = "Хлеб" if gift_item == "bread" else "Пшеница"
		text_body += "\n\n[color=green]🎁 %s с улыбкой протянул вам: [b]%s (+1)[/b]![/color]" % [name_str, it_name]
		
	return {
		"title": "%s (%s)" % [name_str, role.capitalize()],
		"text": text_body,
		"gift": gift_item
	}
