; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Medieval Living World RPG"
config/description="Medieval RPG simulation where every NPC has individual needs, memory, and dynamic roles."
config/version="0.1.0"
run/main_scene="res://scenes/game2d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://src/core/EventBus.gd"
TimeManager="*res://src/core/TimeManager.gd"
GameManager="*res://src/core/GameManager.gd"
UIHelpers="*res://src/ui/UIHelpers.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
